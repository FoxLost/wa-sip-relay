# Generate with: openssl rand -hex 32
WACALLS_API_KEY=replace-with-a-random-secret

# LAN address of the Linux/WSL host. Do not use 127.0.0.1.
WACALLS_PUBLIC_IP=192.168.1.10

# Change only when these ports are already occupied.
WACALLS_SIP_ADDR=0.0.0.0:5060
WACALLS_SIP_ADVERTISE_PORT=5060
WACALLS_RTP_PORT_MIN=40000
WACALLS_RTP_PORT_MAX=40049

# Capacity limits. Set 0 only when the host has been sized and tested for it.
WACALLS_MAX_ACCOUNTS=5
WACALLS_MAX_CALLS=1
